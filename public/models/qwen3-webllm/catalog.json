{
 "family": "qwen3-webllm",
 "title": "Qwen3, Qwen3.5 and MiniCPM5 q4f16_1 through the graph catalog's WebGPU runtime",
 "summary": "A patched WebLLM 0.2.84 (device-resident greedy argmax, K-token decode bursts, batched command encoding with periodic flushes, optional lookahead) plus a per-model TVM model lib compiled with chunked argmax and (Qwen3/Qwen3.5) subgroup-32 kernels and GEMV TR. Weights are the stock mlc-ai q4f16_1 shards; only the runtime bundle and the model_lib differ from stock WebLLM. Output is byte-identical under greedy decoding on the workbench corpus; the fast path only engages at temperature 0.",
 "source": {
  "dataset": "ozhyhinas/webnn-catalog",
  "base": "https://huggingface.co/datasets/ozhyhinas/webnn-catalog/resolve/main",
  "fork": "OlehZhyhinas/web-llm-qwen@b9e2b01d3d3f4b5e1fad005da159e31430c65130",
  "webllmVersion": "0.2.84",
  "reports": [
   "webnn-workbench/docs/qwen-m5-webgpu-report.md",
   "webnn-workbench/docs/qwen17-m5-webgpu-report.md",
   "webnn-workbench/docs/qwen4-m5-webgpu-report.md",
   "webnn-workbench/docs/qwen35-08-m5-webgpu-report.md",
   "webnn-workbench/docs/qwen35-4b-m5-webgpu-report.md",
   "webnn-workbench/docs/qwen35-9b-m5-webgpu-report.md",
   "webnn-workbench/docs/minicpm5-2b-m5-webgpu-report.md"
  ]
 },
 "target": {
  "id": "webgpu-apple-m5-pro-macos26-chrome152",
  "gpu": {
   "vendor": "apple",
   "features": [
    "subgroups"
   ]
  },
  "browser": {
   "engine": "chromium",
   "minMajor": 152
  },
  "notes": "Tuned on Apple M5 Pro (20 GPU cores), macOS 26.6, Chrome 152. The model libs enable WGSL subgroups, so the adapter must expose the feature; other Apple GPUs are accepted but unmeasured. A failed load falls back to stock WebLLM and is remembered per model."
 },
