node_modules/
.venv/
.DS_Store

# WebGPU int4 variants are build artifacts (see scripts/build-model-variants.sh)
public/models/*/onnx/*_q4.onnx
public/models/*/onnx/*_fp16.onnx
dist/
# Pre-compressed weights + manifest (see scripts/compress-models.mjs)
public/models/*/**/*.gz
public/models/*/compressed.json
# Texify WebNN constants (~597 MiB); recipes and manifest are in git. Link from
# the workbench IR dir: node scripts/vendor-texify-webnn.mjs --link-bins
public/models/texify-webnn/*.bin
public/models/intellitex-webnn/*.bin
